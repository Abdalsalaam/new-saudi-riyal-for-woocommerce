<?xml version="1.0"?>
<ruleset name="Saudi Riyal Symbol for WooCommerce">
	<description>WordPress coding standards and the PHP 7.4 floor.</description>

	<file>saudi-riyal-symbol-for-woocommerce.php</file>
	<file>includes</file>
	<file>tests</file>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress">
		<!-- Test classes and bootstrap files follow the PHPUnit layout, not WordPress file naming. -->
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress-Docs"/>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="nsrwc"/>
				<element value="NSRWC"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="saudi-riyal-symbol-for-woocommerce"/>
			</property>
		</properties>
	</rule>

	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.3"/>
</ruleset>
