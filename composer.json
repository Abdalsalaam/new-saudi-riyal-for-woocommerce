{
    "name": "abdalsalaam/saudi-riyal-symbol-for-woocommerce",
    "description": "Adds the Saudi Riyal, UAE Dirham and Omani Rial symbols to WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "yoast/phpunit-polyfills": "^4.0"
    },
    "config": {
        "platform": {
            "php": "7.4.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test": "npx wp-env run tests-cli --env-cwd=wp-content/plugins/saudi-riyal-symbol-for-woocommerce vendor/bin/phpunit"
    },
    "scripts-descriptions": {
        "lint": "WordPress coding standards and PHP 7.4 compatibility.",
        "test": "PHPUnit against a real WordPress + WooCommerce inside wp-env (run `wp-env start` first)."
    }
}
